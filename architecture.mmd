flowchart TB
    client["MCP client<br/>(Claude, VS Code, Cursor, agents)"]
    reviewer["Authorized reviewer"]

    subgraph transport["MCP transports"]
        stdio["stdio<br/>(default)"]
        http["Streamable HTTP<br/>Bearer token required for remote binding"]
    end

    subgraph server["sqlmesh-mcp server"]
        auth["Identity and scope context<br/>named clients, expiry, read/mutate/approve/write/operate"]
        errors["Error translation<br/>SQLMesh/dataveil errors -> ToolError"]
        ro["Read-only tools<br/>metadata, lineage, diffs, health, impact, previews"]
        write["Mutation tools<br/>plan/apply, run, format, cleansing"]
        jobs["Async jobs<br/>start_plan / start_run / status / cancel"]
        resources["MCP resources and prompts<br/>models, model SQL, lineage, explain, review"]
    end

    subgraph safety["Safety controls"]
        envs["Environment allowlist"]
        readonly["SQLMESH_READ_ONLY"]
        cache["Plan cache<br/>TTL, size limit, project/environment binding"]
        preview["Preview controls<br/>row cap, column allowlist, masking"]
        audit["Identity-aware audit log"]
        approvals["Persistent approval records<br/>atomic JSON, mode 0600"]
    end

    subgraph project["SQLMesh project"]
        context["Cached SQLMesh Context"]
        definitions["Models, audits, tests, config"]
        state[("SQLMesh state<br/>environments and snapshots")]
        virtual["Virtual model layer"]
        physical[("Physical snapshot tables")]
    end

    warehouse[("Warehouse engine")]
    dataveil["dataveil<br/>profile, classify, validate, cleanse"]
    files[("Project files<br/>approvals.json / audit.jsonl")]
    ci["GitHub Actions<br/>ruff + pytest"]
    tests["Direct and MCP protocol tests"]
    pypi[("PyPI package")]

    client --> stdio
    client --> http
    stdio --> server
    http --> auth
    auth --> server
    reviewer --> auth

    server --> errors
    server --> ro
    server --> write
    server --> jobs
    server --> resources

    write --> envs
    write --> readonly
    write --> cache
    ro --> preview
    write --> audit
    write --> approvals
    auth --> audit

    ro --> context
    write --> context
    jobs --> context
    resources --> context
    context --> definitions
    context --> state
    context --> virtual
    virtual --> physical
    physical --> warehouse
    state --> warehouse

    dataveil --> physical
    dataveil --> audit
    audit --> files
    approvals --> files

    ci --> server
    ci --> tests
    pypi --> server

    classDef read fill:#eff6ff,stroke:#2563eb
    classDef mutate fill:#fef2f2,stroke:#dc2626
    classDef security fill:#fff7ed,stroke:#ea580c
    classDef state fill:#f0fdf4,stroke:#16a34a
    class ro,resources read
    class write,jobs mutate
    class auth,envs,readonly,cache,preview,audit,approvals security
    class context,definitions,state,virtual,physical,warehouse,files state
